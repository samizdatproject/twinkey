{
  "name": "twinkey",
  "version": "0.1.0",
  "description": "Link a Bitcoin Cash address and a Nostr key with two signatures: publish, discover, verify and log in, with no identity server.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "test": "vitest run",
    "cli": "node --experimental-transform-types --no-warnings src/cli.ts",
    "auth-server": "node --experimental-transform-types --no-warnings examples/auth-server.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "nostr-tools": "2.25.2",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.5.14",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "ws": "^8.18.3"
  }
}
